      this.selectedSource = source2;
      if (source2 === "clone") {
        this.$emit("update:selectedVoiceId", null);
        if (this.voiceCloneReady) {
          this.$emit("update:useClonedVoice", true);
        }
      }
    },
    selectStudioVoice(voice) {
      this.$emit("update:selectedVoiceId", voice.id);
      this.$emit("update:useClonedVoice", false);
    },
    async togglePreview(voice) {
      if (this.previewingVoiceId === voice.id) {
        this.stopPreview();
        return;
      }
      this.stopPreview();
      this.previewLoadingId = voice.id;
      try {
        const sampleText = this.getPreviewText();
        const audioUrl = await appSpeechService.synthesizeSpeech(sampleText, voice.id, this.language);
        if (!audioUrl) return;
        this.previewAudio = new Audio(audioUrl);
