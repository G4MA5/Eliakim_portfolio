  /**
   * Construit l'URL de base pour les ressources statiques
   * @returns {string} URL de base (ex: https://domain.com/static)
   */
  getBaseUrl() {
    const protocol = AppEnvVariablesService.getEnv("APP_PROTOCOL") || "https";
    const domain = AppEnvVariablesService.getEnv("APP_DOMAIN") || window.location.host;
    return `${protocol}://${domain}/static`;
  }
  /**
   * Construit une URL complète pour une ressource statique
   * @param {string} path - Chemin relatif (ex: 'talent/banner.png' ou '/talent/banner.png')
   * @returns {string} URL complète
   */
  buildUrl(path) {
    if (!path) return "";
    const cleanPath = path.startsWith("/") ? path.substring(1) : path;
    return `${this.getBaseUrl()}/${cleanPath}`;
  }
  /**
   * Construit une URL pour les ressources du module Talent
   * @param {string} filename - Nom du fichier (ex: 'banner.png')
   * @returns {string} URL complète
   */
  talentUrl(filename) {
    return this.buildUrl(`talent/${filename}`);
  }
  /**
   * Construit une URL pour les images du module Talent
   * @param {string} filename - Nom du fichier image
   * @returns {string} URL complète
   */
  talentImageUrl(filename) {
    return this.buildUrl(`talent/images/${filename}`);
  }
  /**
   * Construit une URL pour les logos des entreprises partenaires (Talent)
   * @param {string} filename - Nom du fichier logo
   * @returns {string} URL complète
   */
  talentCompanyLogoUrl(filename) {
    return this.buildUrl(`talent/images/companies/${filename}`);
  }
  /**
   * Construit une URL pour les ressources du module RMS
   * @param {string} filename - Nom du fichier
   * @returns {string} URL complète
   */
  rmsUrl(filename) {
    return this.buildUrl(`rms/${filename}`);
  }
  /**
   * Construit une URL pour les images du module RMS
   * @param {string} filename - Nom du fichier image
   * @returns {string} URL complète
   */
  rmsImageUrl(filename) {
    return this.buildUrl(`rms/images/${filename}`);
  }
  /**
   * Construit une URL pour les ressources du module ACE
   * @param {string} path - Chemin relatif dans le module ACE
   * @returns {string} URL complète
   */
  aceUrl(path) {
    return this.buildUrl(`ace/${path}`);
  }
  /**
   * Construit une URL pour les ressources du module Modular
   * @param {string} filename - Nom du fichier
   * @returns {string} URL complète
   */
  modularUrl(filename) {
    return this.buildUrl(`modular/${filename}`);
  }
  /**
   * Construit une URL pour les images du module Modular
   * @param {string} filename - Nom du fichier image
   * @returns {string} URL complète
   */
  modularImageUrl(filename) {
    return this.buildUrl(`modular/images/${filename}`);
  }
  /**
   * Construit une URL pour les profils utilisateurs
   * @param {string|number} userId - ID de l'utilisateur
   * @param {string} filename - Nom du fichier (ex: 'profil.png')
   * @returns {string} URL complète
   */
  profileUrl(userId, filename = "profil.png") {
    return this.buildUrl(`profil/${userId}/${filename}`);
  }
  /**
   * Construit une URL pour les CV utilisateurs
   * @param {string|number} userId - ID de l'utilisateur
   * @param {string} filename - Nom du fichier CV
   * @returns {string} URL complète
   */
  cvUrl(userId, filename) {
    return this.buildUrl(`users/${userId}/${filename}`);
  }
  /**
   * Construit une URL pour les images de quiz
   * @param {string|number} quizId - ID du quiz
   * @param {string} filename - Nom du fichier (ex: 'profile.png')
   * @returns {string} URL complète
   */
  quizImageUrl(quizId, filename = "profile.png") {
    return this.buildUrl(`talent/quiz/${quizId}/${filename}`);
  }
  /**
   * Construit une URL pour les vidéos de section meeting (ACE)
   * @param {string|number} sectionId - ID de la section
   * @returns {string} URL complète
   */
  aceSectionVideoUrl(meetingId, sectionId) {
