        }
      }
    },
    enterHighlightMode() {
      console.log("[TranslationQuickEdit] Entering highlight mode");
      this.highlightMode = true;
      document.body.classList.add("i18n-highlight-active");
      document.addEventListener("mousemove", this.handleMouseMove);
    },
    exitHighlightMode() {
      console.log("[TranslationQuickEdit] Exiting highlight mode");
      this.highlightMode = false;
      this.highlightedElement = null;
      this.highlightedCode = "";
      document.body.classList.remove("i18n-highlight-active");
      document.removeEventListener("mousemove", this.handleMouseMove);
    },
    handleMouseMove(event) {
      if (!this.highlightMode) return;
      const element = event.target.closest("[data-i18n]");
      console.log("[TranslationQuickEdit] MouseMove, target:", event.target.tagName, "found data-i18n:", element ? element.dataset.i18n : "none");
      if (element) {
        if (element !== this.highlightedElement) {
          this.highlightedElement = element;
          this.highlightedCode = element.dataset.i18n;
          this.updateHighlightPosition(element);
          console.log("[TranslationQuickEdit] Highlighting:", this.highlightedCode);
        }
      } else {
        let parent = event.target;
        while (parent && parent !== document.body) {
          if (parent.dataset && parent.dataset.i18n) {
            if (parent !== this.highlightedElement) {
              this.highlightedElement = parent;
              this.highlightedCode = parent.dataset.i18n;
              this.updateHighlightPosition(parent);
