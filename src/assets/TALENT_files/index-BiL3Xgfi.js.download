        }
        const selectedText = window.getSelection().toString().trim();
        console.log("[TranslationQuickEdit] Alt+T pressed, selected text:", selectedText);
        this.open(selectedText);
      }
      if (event.key === "Alt" && event.ctrlKey) {
        console.log("[TranslationQuickEdit] Ctrl+Alt pressed, highlightMode:", this.highlightMode);
        if (!this.highlightMode) {
          this.enterHighlightMode();
        }
      }
      if (event.key === "Escape" && this.highlightMode) {
