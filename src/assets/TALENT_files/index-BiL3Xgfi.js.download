  name: "AiaVoiceCloneDialog",
  props: {
    modelValue: { type: Boolean, default: false },
    voiceCloneReady: { type: Boolean, default: false },
    useClonedVoice: { type: Boolean, default: false },
    isDefault: { type: Boolean, default: false },
    selectedVoiceId: { type: String, default: null },
    language: { type: String, default: "fr" }
  },
  emits: ["update:modelValue", "update:useClonedVoice", "update:selectedVoiceId", "uploaded", "delete"],
  data() {
    return {
      state: "idle",
      // idle | recording | uploading
      selectedSource: "clone",
      // 'clone' | 'studio'
      // Preset voices from Edge TTS
      studioVoices: [],
      loadingVoices: false,
      previewingVoiceId: null,
      previewLoadingId: null,
      previewAudio: null,
      langFilter: null,
      // Recording
      recordingSeconds: 0,
      recordingTimer: null,
      mediaRecorder: null,
      mediaStream: null,
      chunks: [],
      // Audio analysis for live bars
      analyser: null,
      analyserData: null,
      animFrame: null,
      liveBars: Array(24).fill(0),
      // Playback
      recordedUrl: null,
      recordedBlob: null,
      isPlaying: false,
      playbackTime: 0,
      playbackDuration: 0,
      // Waveform drawing
      audioContext: null,
      waveformDrawn: false
    };
  },
  watch: {
    modelValue(open2) {
      if (!open2) {
        this.cleanup();
      } else {
        this.loadAvailableVoices();
        if (this.selectedVoiceId?.startsWith("studio:") || this.selectedVoiceId?.startsWith("predefined:") || this.selectedVoiceId?.startsWith("ref:")) {
          this.selectedSource = "studio";
        }
      }
    }
  },
  computed: {
    /** Preset voices from Edge TTS */
    presetVoices() {
      return this.studioVoices.filter((v) => v.type === "default" || v.type === "studio" || v.type === "predefined" || v.type === "kokoro" || v.type === "edge");
    },
    /** Label for the preset voices button */
    presetVoicesLabel() {
      return "Voix";
    },
    /** Preset voices filtered by selected language */
    filteredPresetVoices() {
      if (!this.langFilter) return this.presetVoices;
      return this.presetVoices.filter((v) => v.lang === this.langFilter);
    },
    /** Available languages extracted from preset voices (for filter chips) */
    availableLanguages() {
      const langMap = {};
      for (const v of this.presetVoices) {
        const code = v.lang || "en";
        if (!langMap[code]) {
          langMap[code] = { code, flag: v.flag || "🇺🇸", label: this.langLabel(code), count: 0 };
        }
        langMap[code].count++;
      }
      return Object.values(langMap).sort((a, b) => a.label.localeCompare(b.label));
    }
  },
  beforeUnmount() {
    this.cleanup();
  },
  methods: {
    close() {
      this.cleanup();
      this.$emit("update:modelValue", false);
    },
    cleanup() {
      this.stopRecording();
      this.stopPlayback();
      this.stopPreview();
      if (this.animFrame) cancelAnimationFrame(this.animFrame);
      this.animFrame = null;
    },
    /** Get a preview text in the current TTS language */
    getPreviewText() {
      const texts = {
        fr: "Bonjour, je suis une voix de synthèse. Voici un aperçu de ma voix.",
        en: "Hello, I am a synthesis voice. Here is a preview of my voice.",
        es: "Hola, soy una voz de síntesis. Aquí tienes una muestra de mi voz.",
        de: "Hallo, ich bin eine Synthesestimme. Hier ist eine Vorschau meiner Stimme.",
        it: "Ciao, sono una voce di sintesi. Ecco un'anteprima della mia voce.",
        pt: "Olá, eu sou uma voz de síntese. Aqui está uma prévia da minha voz.",
        nl: "Hallo, ik ben een synthesetem. Hier is een voorbeeld van mijn stem.",
        pl: "Cześć, jestem głosem syntezy. Oto podgląd mojego głosu.",
        tr: "Merhaba, ben bir sentez sesiyim. İşte sesimin bir önizlemesi.",
        ru: "Здравствуйте, я голос синтеза. Вот пример моего голоса.",
        ar: "مرحبا، أنا صوت اصطناعي. إليكم معاينة لصوتي.",
        zh: "你好，我是合成语音。这是我声音的预览。",
        ja: "こんにちは、私は合成音声です。私の声のプレビューです。",
        ko: "안녕하세요, 저는 합성 음성입니다. 제 목소리의 미리보기입니다.",
        hu: "Szia, egy szintetizált hang vagyok. Itt egy előzetes a hangomról.",
        cs: "Ahoj, jsem syntetizovaný hlas. Zde je ukázka mého hlasu.",
        hi: "नमस्ते, मैं एक संश्लेषण आवाज़ हूँ। यहाँ मेरी आवाज़ का पूर्वावलोकन है।"
      };
      return texts[this.language] || texts.fr;
    },
    // ── Voice selection ──
    async loadAvailableVoices() {
      if (this.studioVoices.length > 0) return;
      this.loadingVoices = true;
      try {
        const voices = await appSpeechService.getAvailableVoices();
        this.studioVoices = voices.filter((v) => v.type === "default" || v.type === "studio" || v.type === "predefined" || v.type === "clone" || v.type === "kokoro" || v.type === "edge");
      } catch (e2) {
        console.warn("[VoiceClone] Could not load voices:", e2);
      } finally {
        this.loadingVoices = false;
      }
    },
